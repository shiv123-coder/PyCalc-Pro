{
  "manifest_version": 3,
  "name": "PyCalc Pro Extension",
  "version": "1.0",
  "description": "Smart Math Dashboard in your browser toolbar.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open PyCalc Pro"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.sudoku.com/*"
  ]
}
